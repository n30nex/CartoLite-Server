# Copy this file to .env and configure your MQTT feed. No map key or build is needed.
# Keep .env and any optional .secrets files private.
CARTOLITE_IMAGE=ghcr.io/n30nex/cartolite-server:0.5.0
CARTOLITE_BIND_ADDR=127.0.0.1
CARTOLITE_PORT=8080
# Optional CARTO override: see compose.carto.yml and docs/deployment.md.
# CARTO_BASEMAP_API_KEY_FILE=.secrets/carto-basemap-api-key

# Your standard MeshCore MQTT feed.
MQTT_BROKER_URL=tcp://broker.example.invalid:1883
MQTT_TOPIC=meshcore/#
MQTT_CLIENT_ID=cartolite-server
MQTT_USERNAME=
MQTT_PASSWORD=
# Empty accepts every valid region. Set exact comma-separated region labels to filter.
REGION_ALLOWLIST=
MQTT_INGEST_QUEUE_SIZE=4096

# Runtime state is a single atomic checkpoint, not an event database.
STATE_PATH=/data/state-v1.json
LOG_LEVEL=info
